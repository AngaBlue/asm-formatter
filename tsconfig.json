{
	"compilerOptions": {
		"module": "commonjs",
		"target": "esnext",
		"outDir": "build",
		"rootDir": "src",
		"esModuleInterop": true,
		"noImplicitAny": true,
		"typeRoots": ["node_modules/@types", "src/typings"],
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"lib": ["ESNext"],
		"pretty": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true
	},
	"include": ["src"]
}
